<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tool_tip_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:filterTouchesWhenObscured="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/tool_tip_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/sud_setup_tooltip_padding_top"
        android:paddingBottom="@dimen/sud_setup_tooltip_padding_bottom"
        android:minHeight="@dimen/sud_setup_tooltip_min_height"
        android:minWidth="@dimen/sud_setup_tooltip_min_width">

    <LinearLayout
        android:layout_width="@dimen/sud_setup_tooltip_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical">

      <com.google.android.setupdesign.view.RichTextView
          android:id="@+id/text_primary_tooltip"
          style="?attr/sudItemTitleStyle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textAlignment="center" />

      <com.google.android.setupdesign.view.RichTextView
          android:id="@+id/text_secondary_tooltip"
          style="?attr/sudItemSummaryStyle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingTop="@dimen/sud_setup_tooltip_secondary_text_padding_top"
          android:textAlignment="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_primary_tooltip"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/sud_setup_tooltip_button_margin_top"
        android:fontFamily="sans-serif-medium"
        android:textSize="@dimen/sud_setup_tooltip_button_text_size"
        app:cornerRadius="@dimen/sud_setup_tooltip_button_corner_radius"
        app:strokeWidth="@dimen/sud_setup_tooltip_button_stroke_width"
        app:strokeColor="@color/sud_on_secondary_container"
        android:textColor="@color/sud_on_secondary_container" />
    </LinearLayout>
  </FrameLayout>

</FrameLayout>